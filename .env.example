# Copy this file to .env and fill in the values from your own Firebase
# project: https://console.firebase.google.com
#
# The REACT_APP_ prefix is required -- Create React App discards any
# variable without it. .env is read only at startup, so restart the dev
# server after editing it.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
